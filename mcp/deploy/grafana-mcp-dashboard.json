      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (le, name) (rate(penpot_rpc_main_timing_bucket{name=~\".*mcp.*\"}[5m])))",
          "legendFormat": "p50 {{name}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, name) (rate(penpot_rpc_main_timing_bucket{name=~\".*mcp.*\"}[5m])))",
          "legendFormat": "p95 {{name}}",
          "range": true
        }
      ]
    },
