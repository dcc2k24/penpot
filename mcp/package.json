{
  "name": "@penpot/mcp",
  "version": "2.17.0",
  "description": "MCP server for Penpot integration",
  "license": "MPL-2.0",
  "bin": {
    "penpot-mcp": "./bin/mcp-local.js"
  },
  "scripts": {
    "build": "pnpm -r --filter mcp-common --filter mcp-server --filter mcp-plugin run build",
    "build:multi-user": "pnpm -r run build:multi-user",
    "build:types": "bash ./scripts/build-types",
    "start": "pnpm --parallel --filter mcp-server --filter mcp-plugin run start",
    "start:multi-user": "pnpm --parallel --filter mcp-server --filter mcp-plugin run start:multi-user",
    "bootstrap": "pnpm -r --filter mcp-common --filter mcp-server --filter mcp-plugin install && pnpm run build && pnpm run start",
    "bootstrap:multi-user": "pnpm -r --filter mcp-common --filter mcp-server --filter mcp-plugin install && pnpm run build && pnpm run start:multi-user",
    "client-setup": "node bin/client-setup.js",
    "fmt": "prettier --write packages/",
    "fmt:check": "prettier --check packages/",
    "test": "pnpm -r run test",
    "loadtest": "pnpm --filter mcp-loadtest run cli",
    "design-parity": "pnpm --filter mcp-design-parity run cli",
    "prepack": "node -e \"require('fs').copyFileSync('pnpm-lock.yaml', 'pnpm-lock.dist.yaml')\"",
    "postpack": "node -e \"require('fs').rmSync('pnpm-lock.dist.yaml', { force: true })\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/penpot/penpot.git"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "devDependencies": {
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10"
  },
  "files": [
    "bin/",
    "pnpm-workspace.yaml",
    "pnpm-lock.dist.yaml",
    "packages/common/",
    "packages/server/",
    "packages/plugin/",
    "packages/loadtest/package.json",
    "packages/design-parity/package.json",
    "packages/design-parity/app/package.json",
    "!**/node_modules/",
    "!**/dist/",
    "!**/*.test.ts",
    "!packages/server/src/backend/testing/",
    "!packages/server/src/tools/backend/ExecuteCodeHarness.ts",
    "!packages/server/scripts/integration-test-*.ts"
  ]
}
