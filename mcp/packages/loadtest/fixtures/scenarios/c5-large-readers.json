{
  "name": "C5-large-readers",
  "description": "Plan 8.4 C5: 20 agents read the generated large file at the same time, each with its own token (pass the generate-large vars file). Each agent reads the outline, 20 page trees, 50 get_shapes calls and 20 find_shapes calls, at most 10 calls per second. Pass when the backend heap peak stays under 80 % of -Xmx (run with --metrics), no GC pause passes 1 s, and no call fails. The human half (another file opens no more than 20 % slower) needs a browser and is not covered here.",
  "agents": 20,
  "iterations": 1,
  "steps": [
    {
      "name": "file outline",
      "tool": "get_file_outline",
      "rateLimitPerSecond": 10,
      "args": { "fileId": "${fileId}" },
      "capture": { "pageIds": "$.result.pages[*].id" }
    },
    {
      "name": "page tree of each page",
      "tool": "get_page_tree",
      "repeat": 20,
      "rateLimitPerSecond": 10,
      "args": { "fileId": "${fileId}", "pageId": "${pageIds[index]}", "depth": 3, "limit": 500 }
    },
    {
      "name": "find shapes for get_shapes",
      "tool": "find_shapes",
      "rateLimitPerSecond": 10,
      "args": { "fileId": "${fileId}", "pageId": "${pageIds[agent]}", "type": "rect", "limit": 50 },
      "capture": { "shapeIds": "$.result.matches[*].id" }
    },
    {
      "name": "get_shapes one id",
      "tool": "get_shapes",
      "repeat": 50,
      "rateLimitPerSecond": 10,
      "args": { "fileId": "${fileId}", "pageId": "${pageIds[agent]}", "ids": ["${shapeIds[index]}"] }
    },
    {
      "name": "find_shapes one page",
      "tool": "find_shapes",
      "repeat": 20,
      "rateLimitPerSecond": 10,
      "args": { "fileId": "${fileId}", "pageId": "${pageIds[index]}", "type": "frame", "nameRegex": "^Board", "limit": 100 }
    }
  ]
}
