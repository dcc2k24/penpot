{
  "name": "C4-same-shape",
  "description": "Plan 8.4 C4, MCP side: two writers change the same attribute of one shape. Step 2 plays the other writer (each call is its own MCP session), step 3 writes with the stale baseRevn of step 1 and must get a revn-lag warning that names the shape, step 4 asks for failOnConflict and must be refused, and step 5 reads back the last writer's value. The human tab half of C4 (both sides converge after the notifications) needs a browser and is not covered here.",
  "agents": 1,
  "iterations": 1,
  "freshPage": true,
  "steps": [
    {
      "name": "create the shared rect",
      "tool": "apply_operations",
      "args": {
        "fileId": "${fileId}",
        "operations": [
          { "op": "create_rect", "id": "$tmp:r", "pageId": "${pageId}", "name": "C4 shared ${runId}", "x": 0, "y": 0, "width": 100, "height": 100 }
        ]
      },
      "capture": { "rectId": "$.result.createdIds[\"$tmp:r\"]", "baseRevn": "$.result.revn" }
    },
    {
      "name": "other writer sets blue",
      "tool": "apply_operations",
      "args": {
        "fileId": "${fileId}",
        "operations": [
          { "op": "update_shape", "pageId": "${pageId}", "id": "${rectId}", "props": { "fills": [{ "fillColor": "#0000ff", "fillOpacity": 1 }] } }
        ]
      }
    },
    {
      "name": "agent sets red with a stale baseRevn",
      "tool": "apply_operations",
      "args": {
        "fileId": "${fileId}",
        "baseRevn": "${baseRevn}",
        "operations": [
          { "op": "update_shape", "pageId": "${pageId}", "id": "${rectId}", "props": { "fills": [{ "fillColor": "#ff0000", "fillOpacity": 1 }] } }
        ]
      },
      "expect": [
        { "path": "$.result.warnings[*].kind", "contains": "revn-lag" },
        { "path": "$.result.warnings[0].changedShapeIds", "contains": "${rectId}" }
      ]
    },
    {
      "name": "failOnConflict with the stale baseRevn is refused",
      "tool": "apply_operations",
      "args": {
        "fileId": "${fileId}",
        "baseRevn": "${baseRevn}",
        "failOnConflict": true,
        "operations": [
          { "op": "update_shape", "pageId": "${pageId}", "id": "${rectId}", "props": { "fills": [{ "fillColor": "#00ff00", "fillOpacity": 1 }] } }
        ]
      },
      "expectError": "conflict"
    },
    {
      "name": "read back the last writer's value",
      "tool": "get_shapes",
      "args": { "fileId": "${fileId}", "pageId": "${pageId}", "ids": ["${rectId}"], "fields": ["id", "fills"] },
      "expect": { "path": "$.result.shapes[0].fills[0].fillColor", "equals": "#ff0000" }
    }
  ]
}
