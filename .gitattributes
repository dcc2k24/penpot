frontend/vendor/* linguist-vendored

# Scripts run inside Linux containers and WSL. Keep them LF in every
# checkout, also on Windows with core.autocrlf=true, or bash fails with
# "$'\r': command not found". text=auto leaves binary files untouched.
*.sh                       text eol=lf
**/scripts/**              text=auto eol=lf
docker/**                  text=auto eol=lf
render-wasm/*              text=auto eol=lf
mcp/types-generator/build  text eol=lf
